# Copier vers .env (non commité).

# Connexion Redis. En local, le docker-compose de ce dépôt écoute sur 6379.
# En production CapRover : redis://:<mot-de-passe>@srv-captain--redis:6379
REDIS_URL=redis://127.0.0.1:6379

# Brevo > SMTP & API > API Keys.
BREVO_API_KEY=
# Adresse validée dans Brevo > Senders & IP > Senders.
# Le jour où un domaine authentifié SPF/DKIM existe, seule cette ligne change.
BREVO_SENDER_EMAIL=
# Optionnel, défaut « Grindrise ».
BREVO_SENDER_NAME=Grindrise
# Optionnel, aucune adresse de réponse par défaut.
BREVO_REPLY_TO=

# Optionnels — doivent rester alignés avec l'API pour NOTIFICATIONS_QUEUE_NAME.
NOTIFICATIONS_QUEUE_NAME=notifications
WORKER_CONCURRENCY=5
PORT=3001
LOG_LEVEL=info
